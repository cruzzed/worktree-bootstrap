#!/usr/bin/env bash
# Example .wtbs/ preset (Django + uv). Copy into your project's .wtbs/ folder;
# each file there becomes a named command:
#
#   worktree-bootstrap feature/x runserver          # uses this worktree's port
#   worktree-bootstrap feature/x runserver 0.0.0.0:9000   # extra args pass through
#
# Presets run in the worktree with its .env exported and .venv/bin on PATH.
# The template context arrives as WTBS_* env vars (presets are not
# template-rendered): WTBS_BRANCH, WTBS_BRANCH_SLUG, WTBS_SITE, WTBS_DB_NAME,
# WTBS_WORKTREE_ROOT, WTBS_MAIN_REPO, WTBS_PORT_APP/_DB/_VITE/_SERVE/...
exec uv run python manage.py runserver "${WTBS_PORT_SERVE:-8000}" "$@"
